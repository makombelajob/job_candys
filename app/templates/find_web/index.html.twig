{% extends 'base.html.twig' %}

{% block title %}Recherche site officiel
{% endblock %}

{% block body %}
	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/find_web.css') }}">
	{% endblock %}


	<div class="full-screen">
		<div class="card">
			<h1>Recherche site officiel</h1>

			<div class="info">
				<p>
					<strong>Nom :</strong>
					{{ nom }}
				</p>

				<p>
					<strong>SIRET :</strong>
					{{ siret }}
				</p>

				<p>
					<strong>Adresse :</strong>
					{{ adresse|nl2br }}
				</p>

				<p>
					<strong>Site web :</strong>
					{% if resultat starts with 'http' %}
						<a href="{{ resultat }}" target="_blank">
							{{ resultat }}
						</a>
					{% else %}
						{{ resultat }}
					{% endif %}
				</p>
			</div>

			{% if is_granted('ROLE_FREELANCE') %}
				<div class="actions">
					<a href="{{ path('app_find_contact', {'siret': siret}) }}" data-siret={{ siret }} id="trouver-contact" class="btn primary" data-loading="Recherche...">
						Trouver contact
					</a>

					<a href="#" id="check-web" class="btn primary" data-loading="Vérification...">
						Check web
					</a>
				</div>

			{% else %}
				<div class="actions">
					<a href="{{ path('app_find_contact', {'siret': siret}) }}" data-siret={{ siret }} id="trouver-contact" class="btn primary" data-loading="Recherche...">Trouver contact</a>
				</div>

			{% endif %}


		</div>
	</div>

	<script src="{{ asset('js/find_web.js') }}"></script>
{% endblock %}
