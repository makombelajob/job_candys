{% extends 'base.html.twig' %}

{% block title %}Test ContactFinderService
{% endblock %}

{% block body %}
	<div style="max-width: 800px; margin: 50px auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
		<h1>Test WebsiteContactFinderService</h1>

		<div style="margin: 20px 0; padding: 10px; background-color: #f0f0f0; border-radius: 3px;">
			<strong>Site web analysé :</strong>
			<code>{{ website }}</code>
		</div>

		{% if errorMessage %}
			<div style="margin: 20px 0; padding: 10px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 3px; color: #721c24;">
				<strong>❌ Erreur :</strong>
				{{ errorMessage }}
			</div>
		{% elseif emails %}
			<div style="margin: 20px 0; padding: 10px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 3px; color: #155724;">
				<strong>✅ Contacts trouvés ({{ emails|length }}) :</strong>
				<ul>
					{% for email in emails %}
						<li>
							<a href="mailto:{{ email }}" style="color: #155724; text-decoration: underline;">{{ email }}</a>
						</li>
					{% endfor %}
				</ul>
			</div>
		{% else %}
			<div style="margin: 20px 0; padding: 10px; background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 3px; color: #856404;">
				<strong>⚠️ Aucun contact trouvé</strong>
			</div>
		{% endif %}

		<hr>

		<h3>Tester avec d'autres sites :</h3>
		<ul>
			<li>
				<a href="{{ path('app_test_contact_finder') }}?website=https://google.fr">Google</a>
			</li>
			<li>
				<a href="{{ path('app_test_contact_finder') }}?website=https://amazon.com">Amazon</a>
			</li>
			<li>
				<a href="{{ path('app_test_contact_finder') }}?website=https://airbus.com">Airbus</a>
			</li>
			<li>
				<a href="{{ path('app_test_contact_finder') }}?website=https://github.com">GitHub</a>
			</li>
			<li>
				<a href="{{ path('app_test_contact_finder') }}?website=https://symfony.com">Symfony</a>
			</li>
		</ul>

		<hr>
		<p style="font-size: 0.9em; color: #666;">
			Ce test permet de vérifier que le WebsiteContactFinderService fonctionne correctement en scannant un site web pour extraire les adresses email de contact.
		</p>
	</div>
{% endblock %}
