{% extends 'base.html.twig' %}

{% block title %}Visiteurs
{% endblock %}

{% block body %}

	<div
		class="container py-4">

		{# En-tête #}
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
			<div>
				<h1 class="h2 mb-1">
					<i class="bi bi-people me-2"></i>
					Visiteurs
				</h1>

				<p class="text-body-secondary mb-0">
					Consultez les visiteurs enregistrés sur votre site.
				</p>
			</div>

			<span class="badge text-bg-primary fs-6 px-3 py-2">
				{{ visitors|length }}
				visiteur{{ visitors|length > 1 ? 's' : '' }}
			</span>
		</div>

		{# Tableau #}
		<div class="card shadow-sm border-0">

			<div class="card-header bg-body py-3">
				<h2 class="h5 mb-0">
					Liste des visiteurs
				</h2>
			</div>

			<div class="card-body p-0">

				{% if visitors is not empty %}

					<div class="table-responsive">

						<table class="table table-hover align-middle mb-0">

							<thead class="table-light">
								<tr>
									<th scope="col" class="px-4">#</th>
									<th scope="col">Adresse IP</th>
									<th scope="col">User-Agent</th>
									<th scope="col" class="text-center">Visites</th>
									<th scope="col">Première visite</th>
									<th scope="col">Dernière visite</th>
								</tr>
							</thead>

							<tbody>

								{% for visitor in visitors %}

									<tr>
										<td class="px-4 fw-semibold">
											{{ visitor.id }}
										</td>

										<td>
											<code>{{ visitor.ipAddress }}</code>
										</td>

										<td style="min-width: 300px; max-width: 500px;">
											<div class="text-truncate" title="{{ visitor.userAgent }}">
												{{ visitor.userAgent }}
											</div>
										</td>

										<td class="text-center">
											<span class="badge text-bg-primary rounded-pill px-3">
												{{ visitor.visitCount }}
											</span>
										</td>

										<td>
											<div class="small">
												{{ visitor.firstVisitAt|date('d/m/Y') }}
											</div>
											<div class="small text-body-secondary">
												{{ visitor.firstVisitAt|date('H:i:s') }}
											</div>
										</td>

										<td>
											<div class="small">
												{{ visitor.lastVisitAt|date('d/m/Y') }}
											</div>
											<div class="small text-body-secondary">
												{{ visitor.lastVisitAt|date('H:i:s') }}
											</div>
										</td>
									</tr>

								{% endfor %}

							</tbody>

						</table>

					</div>

				{% else %}

					<div class="text-center py-5 px-3">

						<i class="bi bi-people display-4 text-body-secondary"></i>

						<h3 class="h5 mt-3">
							Aucun visiteur enregistré
						</h3>

						<p class="text-body-secondary mb-0">
							Les visiteurs apparaîtront ici automatiquement.
						</p>

					</div>

				{% endif %}

			</div>

		</div>

	</div>

{% endblock %}
