{% extends 'base.html.twig' %}

{% block title %}Recherche contacts
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/find_web.css') }}">
{% endblock %}

{% block body %}

	<div class="full-screen">

		<div class="card">

			<h1>Recherche contacts</h1>

			{{ include('_components/_flash_message.html.twig') }}

			<div class="info">

				{% if website is defined and website %}

					<p>
						<strong>Site analysé :</strong>
						{{ website }}
					</p>

				{% endif %}

				{% if emails is defined and emails %}

					<div class="info">

						<h3>Contacts trouvés :</h3>

						<ul>

							{% for email in emails %}

								<li>
									{{ email }}
								</li>

							{% endfor %}

						</ul>

					</div>


				{% elseif emails is defined and emails is null and not errorMessage %}

					<div class="info">
						Aucun contact trouvé.
					</div>

				{% endif %}

			</div>

			{% if is_granted('ROLE_FREELANCE') %}

				<div class="actions">

					{% if hasContacts %}

						<a href="{{ path('app_freelance_proposition', { 'siret': company.siret }) }}" id="trouver-contact" class="btn primary">
							Proposition
						</a>

					{% elseif company is defined and company %}

						<a href="{{ path('app_edit_contact', { 'siret': company.siret }) }}" class="btn primary">
							Modifier manuellement
						</a>

					{% endif %}

				</div>


			{% else %}

				<div class="actions">

					{% if hasContacts %}

						<a href="{{ path('app_spontaneous_application_send', { 'siret': company.siret }) }}" id="trouver-contact" class="btn primary">
							Postuler
						</a>

					{% elseif company is defined and company %}

						<a href="{{ path('app_edit_contact', { 'siret': company.siret }) }}" class="btn primary">
							Ajouter manuellement un contact
						</a>

					{% endif %}

				</div>

			{% endif %}

		</div>

	</div>

{% endblock %}
