{% extends 'base.html.twig' %}

{% block title %}Hello FindContactController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper
		{
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code
		{
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<h1>Recherche contacts</h1>

		{% if website is defined and website %}
			<p>
				Site analysé :
				<strong>{{ website }}</strong>
			</p>
		{% endif %}

		{% if message is defined %}
			<div class="info">
				{{ message }}
			</div>
		{% endif %}

		{% if emails is defined and emails %}
			<div class="info">
				<h3>Contacts trouvés :</h3>

				<ul>
					{% for email in emails %}
						<li>{{ email }}</li>
					{% endfor %}
				</ul>
			</div>
		{% elseif emails is defined %}
			<div class="info">
				Aucun contact trouvé.
			</div>
		{% endif %}


	</div>
{% endblock %}
