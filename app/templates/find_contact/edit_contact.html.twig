{% extends 'base.html.twig' %}

{% block title %}Modifier l'entreprise
{% endblock %}

{% block body %}

	<div class="container py-4">

		<div class="row justify-content-center">
			<div class="col-lg-8">

				<div class="card shadow-sm">

					<div class="card-header">
						<h1 class="h4 mb-0">Modifier l'entreprise</h1>
					</div>

					<div class="card-body">

						{{ form_start(form) }}

						<div class="mb-3">
							{{ form_row(form.fullName) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.siret) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.webSite) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.carrePage) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.linkedin) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.Phone) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.address) }}
						</div>

						<div class="mb-3">
							{{ form_row(form.email) }}
						</div>

						<div class="text-center mt-4">
							<button type="submit" class="btn btn-primary">
								Enregistrer
							</button>
						</div>

						{{ form_end(form) }}

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
