{% extends 'base.html.twig' %}

{% block title %}Modifier l'entreprise
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/profiles.css') }}">
{% endblock %}

{% block body %}

	<div class="profile-page">

		<div class="profile-form">

			<div class="profile-header">
				<h1>Modification de l'entreprise</h1>
				<p>Modifiez les informations de l'entreprise</p>
			</div>


			{# Messages d'erreur Symfony #}

			{{ include('_components/_flash_message.html.twig') }}


			{{ form_start(form) }}


			<div class="form-group">
				{{ form_label(form.fullName) }}
				{{ form_widget(form.fullName) }}
				{{ form_errors(form.fullName) }}
			</div>


			<div class="form-group">
				{{ form_label(form.siret) }}
				{{ form_widget(form.siret) }}
				{{ form_errors(form.siret) }}
			</div>


			<div class="form-group">
				{{ form_label(form.webSite) }}
				{{ form_widget(form.webSite) }}
				{{ form_errors(form.webSite) }}
			</div>


			<div class="form-group">
				{{ form_label(form.carrePage) }}
				{{ form_widget(form.carrePage) }}
				{{ form_errors(form.carrePage) }}
			</div>


			<div class="form-group">
				{{ form_label(form.linkedin) }}
				{{ form_widget(form.linkedin) }}
				{{ form_errors(form.linkedin) }}
			</div>


			<div class="form-group">
				{{ form_label(form.Phone) }}
				{{ form_widget(form.Phone) }}
				{{ form_errors(form.Phone) }}
			</div>


			<div class="form-group">
				{{ form_label(form.address) }}
				{{ form_widget(form.address) }}
				{{ form_errors(form.address) }}
			</div>


			<div class="form-group">
				{{ form_label(form.email) }}
				{{ form_widget(form.email) }}
				{{ form_errors(form.email) }}
			</div>


			<div class="form-actions">

				<button type="submit" class="profile-submit">
					Enregistrer
				</button>

			</div>


			{{ form_end(form) }}

		</div>

	</div>

{% endblock %}
