{% extends 'base.html.twig' %}

{% block title %}Mes candidatures
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/spontaneous-application.css') }}">
{% endblock %}

{% block body %}
	<main class="sa-page">
		<section class="sa-card">
			<div class="sa-card__header">
				<div>
					<p class="sa-card__eyebrow">Suivi de mes candidatures</p>
					<h1>Mes candidatures</h1>
				</div>
				<span class="sa-pill">
					{{ applications|length }}
					candidature
					{% if applications|length > 1 %}s
					{% endif %}
				</span>
			</div>

			{% if applications is empty %}
				<div class="sa-empty">
					<p>Vous n'avez envoyé aucune candidature pour le moment.</p>
				</div>
			{% else %}
				<ul class="sa-list">
					{% for application in applications %}
						<li class="sa-item">
							<div>
								<h2>{{ application.companies.fullName }}</h2>
								<p>{{ application.companies.address }}</p>
							</div>
							<span class="sa-tag">Envoyée le
								{{ application.sentAt|date('d/m/Y H:i') }}</span>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</section>
	</main>
{% endblock %}
