{% extends 'base.html.twig' %}

{% block title %}Envoyer une candidature
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/profiles.css') }}">
{% endblock %}

{% block body %}

	<div class="profile-page">

		<div class="profile-form">

			<div class="profile-header">
				<h1>Envoyer une candidature</h1>

				{% if company is defined %}
					<p>
						Candidature pour :
						<strong>{{ company.name }}</strong>
					</p>
				{% else %}
					<p>Complétez les informations pour envoyer votre candidature</p>
				{% endif %}
			</div>

			{{ include('_components/_flash_message.html.twig') }}


			{{ form_start(form, {
                attr: {
                    enctype: 'multipart/form-data'
                }
            }) }}

			<div class="form-group">
				{{ form_label(form.contact) }}
				{{ form_widget(form.contact) }}
				{{ form_errors(form.contact) }}
			</div>

			<div class="form-group">

				<h3>CV</h3>

				{{ form_row(form.defaultCv) }}
				{{ form_row(form.cv) }}

			</div>

			<div class="form-group">

				<h3>Lettre de motivation</h3>

				{{ form_row(form.defaultLetter) }}
				{{ form_row(form.lettreMotivation) }}

			</div>

			<div class="form-group">
				{{ form_label(form.message) }}
				{{ form_widget(form.message) }}
				{{ form_errors(form.message) }}
			</div>

			<div class="form-actions">
				<button type="submit" class="profile-submit">
					Envoyer ma candidature
				</button>
			</div>

			{{ form_end(form) }}

		</div>

	</div>

{% endblock %}
