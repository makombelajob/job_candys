{% extends 'base.html.twig' %}

{% block title %}Messages
{% endblock %}

{% block body %}

	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/spontaneous-application.css') }}">
	{% endblock %}


	<div class="messages-wrapper">

		<div class="messages-header">
			<h1>Messages</h1>
		</div>

		{% if messages %}

			<div class="message-list">

				{% for message in messages %}

					{% set content = message.text|split('De :')|first %}
					{% set preview = content|striptags|trim %}

					<article class="message-item">

						<div class="message-header">

							<div class="message-from">
								{{ message.from }}
							</div>

							<div class="message-date">
								{{ message.date|date('d/m/Y H:i') }}
							</div>

						</div>

						<div class="message-subject">
							{{ message.subject }}
						</div>

						<div class="message-preview">
							{{ preview }}
						</div>

					</article>

				{% endfor %}

			</div>

		{% else %}

			<p>Aucun message reçu.</p>

		{% endif %}

	</div>

{% endblock %}
