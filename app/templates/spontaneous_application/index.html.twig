{% extends 'base.html.twig' %}

{% block title %}Recherche entreprise
{% endblock %}

{% block body %}
	<div class="wrapper">
		<h1>Recherche entreprise</h1>

		<div class="controls">
			{{ form_start(form) }}
			<div class="control-group">
				{{ form_label(form.mot) }}
				{{ form_widget(form.mot) }}
			</div>
			<button type="submit">Rechercher</button>
			{{ form_end(form) }}
		</div>

		{% if resultats and resultats.unitesLegales is defined %}
			<h2>Résultats</h2>

			<table class="company-table">
				<thead>
					<tr>
						<th>SIREN</th>
						<th>Nom</th>
						<th>Activité</th>
						<th>Localisation</th>
						<th>Website</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					{% for entreprise in resultats.unitesLegales %}
						{% set periode=entreprise.periodesUniteLegale[0] %}
						<tr>
							<td>{{ entreprise.siren|default('') }}</td>

							<td>
								{% if periode.denominationUniteLegale is defined and periode.denominationUniteLegale %}
									{{ periode.denominationUniteLegale }}
								{% else %}
									{{ [
							            entreprise.prenom1UniteLegale|default(''),
							            entreprise.prenom2UniteLegale|default(''),
							            entreprise.prenom3UniteLegale|default(''),
							            entreprise.prenom4UniteLegale|default(''),
							            periode.nomUniteLegale|default('')
						            ]|filter(v=>v)|join(' ') }}
								{% endif %}
							</td>

							<td>{{ periode.activitePrincipaleUniteLegale|default('') }}</td>

							<td>{{ entreprise.adresse|default('') }}</td>

							<td>
								<a class="website" href="#">Website</a>
							</td>

							<td>
								<button class="action-btn">Action</button>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% endif %}
	</div>
{% endblock %}
