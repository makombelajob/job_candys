{% extends 'base.html.twig' %}

{% block title %}Hello AdminController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper
		{
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code
		{
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<h1>Mes candidatures</h1>
		<ul>
			{% if applications is empty %}
				<p>Vous n'avez envoyé aucune candidature.</p>
			{% else %}
				<ul>
					{% for application in applications %}
						<li>
							<p>
								{{ application.companies.fullName }}
							</p>
							<p>
								{{ application.companies.address }}

								<span>
									— envoyée le
									{{ application.sentAt|date('d/m/Y H:i') }}
								</span>
							</p>
						</li>
					{% endfor %}
				</ul>
			{% endif %}


		</ul>
	</div>
{% endblock %}
