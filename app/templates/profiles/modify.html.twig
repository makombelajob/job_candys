{% extends 'base.html.twig' %}

{% block title %}Hello ModifyController
{% endblock %}

{% block body %}
	{% block stylesheets %}
		{{ parent() }}
		<link rel="stylesheet" href="{{ asset('css/find_web.css') }}">
	{% endblock %}

	<div class="full-screen">
		<div class="card pb-2">
			<h1>Modification de votre profil</h1>
			<div class="info">
				{{ form_start(form) }}
				<div>
					<strong>{{ form_label(form.firstName) }}</strong>
					{{ form_widget(form.firstName) }}
				</div>
				<div>
					<strong>{{ form_label(form.lastName) }}</strong>
					{{ form_widget(form.lastName) }}
				</div>
				<div>
					<strong>{{ form_label(form.email) }}</strong>
					{{ form_widget(form.email) }}
				</div>
				<div>
					<strong>{{ form_label(form.phone) }}</strong>
					{{ form_widget(form.phone) }}
				</div>
				<div>
					<strong>{{ form_label(form.city) }}</strong>
					{{ form_widget(form.city) }}
				</div>
				<div>
					<strong>{{ form_label(form.defaultCv) }}</strong>
					{{ form_widget(form.defaultCv) }}
				</div>
				<div>
					<strong>{{ form_label(form.defaultLetter) }}</strong>
					{{ form_widget(form.defaultLetter) }}
				</div>
				<div>
					<strong>{{ form_label(form.linkedin) }}</strong>
					{{ form_widget(form.linkedin) }}
				</div>
				<div>
					<strong>{{ form_label(form.website) }}</strong>
					{{ form_widget(form.website) }}
				</div>
				<div class="text-center p-0 m-0 mt-2">
					<button type="submit" class="btn btn-primary">
						Enregistrer
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>

{% endblock %}
