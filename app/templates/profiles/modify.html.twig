{% extends 'base.html.twig' %}

{% block title %}Hello ModifyController
{% endblock %}

{% block body %}
	<style>
		.example-wrapper
		{
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code
		{
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<h1>Hello</h1>

		{{ form_start(form) }}

		{{ form_row(form.firstName) }}
		{{ form_row(form.lastName) }}
		{{ form_row(form.email) }}

		{{ form_row(form.phone) }}
		{{ form_row(form.city) }}
		{{ form_row(form.defaultCv) }}
		{{ form_row(form.defaultLetter) }}
		{{ form_row(form.linkedin) }}
		{{ form_row(form.website) }}
		{{ form_row(form.photoProfil) }}

		<button type="submit" class="btn btn-primary">
			Enregistrer
		</button>

		{{ form_end(form) }}

	</div>
{% endblock %}
